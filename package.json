{
  "name": "novelnest-backend",
  "main": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node dist/index.js",
    "dev": "bun --watch --no-clear-screen src/index.ts",
    "docker": "cd docker && docker compose up -d && cd ..",
    "prisma:generate": "bunx prisma generate --schema src/database/prisma/schema.prisma",
    "prisma:migrate:dev": "bunx prisma migrate dev --schema src/database/prisma/schema.prisma",
    "prisma:migrate:deploy": "bunx prisma migrate deploy --schema src/database/prisma/schema.prisma",
    "studio": "bunx prisma studio --schema src/database/prisma/schema.prisma",
    "up": "bun run docker && bun run prisma:migrate:deploy && bun run prisma:generate && concurrently --names \"PRISMA, API\" --prefix-colors \"cyan,magenta\" --prefix \"[{time}] [{name}]\" \"bun run studio\" \"bun dev\" ",
    "test": "bun test",
    "test:integration": "RUN_DB_TESTS=1 bun test tests/community.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun run prisma:generate && bun run typecheck && bun scripts/build.ts",
    "start:render": "bun run prisma:migrate:deploy && bun run start"
  },
  "devDependencies": {
    "@types/bun": "1.2.23",
    "concurrently": "9.2.1",
    "prisma": "6.16.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.1.0",
    "@fastify/jwt": "10.0.0",
    "@prisma/client": "6.16.3",
    "@types/node": "24.9.1",
    "bcryptjs": "3.0.2",
    "dotenv": "17.2.3",
    "fastify": "5.6.1",
    "htmlparser2": "^12.0.0",
    "http-errors": "2.0.0",
    "zod": "4.1.12"
  }
}
