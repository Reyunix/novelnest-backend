# Development database. Production credentials belong only in Render environment variables.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/mydb
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173
API_BOOKS_PROVIDER=google
API_BASE_URL_GOOGLE=https://www.googleapis.com/books/v1/volumes
API_KEY_GOOGLE=

# Leave empty until Render's connecting proxy addresses have been verified.
# Never use 0.0.0.0/0 or ::/0. With no trusted proxies, forwarded headers are ignored.
TRUSTED_PROXY_CIDRS=
RATE_API_PER_MINUTE=120
RATE_SEARCH_PER_MINUTE=20
RATE_DETAIL_PER_MINUTE=40
RATE_LOGIN_PER_MINUTE=5
RATE_REGISTER_PER_HOUR=3
RATE_WRITE_PER_MINUTE=30
RATE_REVIEW_PER_MINUTE=10
PROVIDER_DAILY_LIMIT=500
PROVIDER_CACHE_ENTRIES=200
PROVIDER_CONCURRENCY=2
PROVIDER_TIMEOUT_MS=10000
PROVIDER_SEARCH_TTL_MS=300000
PROVIDER_DETAIL_TTL_MS=21600000
